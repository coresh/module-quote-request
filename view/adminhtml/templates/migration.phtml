<?php
/** @var \Coresh\QuoteRequest\Block\Adminhtml\Migration $block */
/** @var \Magento\Framework\Escaper $escaper */
$preview = $block->getPreview();
?>
<div class="message message-notice">
    <?= $escaper->escapeHtml(__('Create a backup and disable the old storefront extension first. Select the original store explicitly: legacy requests do not record their store. Only the verified legacy data schema can be imported.')) ?>
</div>
<?php foreach ($block->getSources() as $source): ?>
    <p><?= $escaper->escapeHtml($source['name']) ?> — <?= $escaper->escapeHtml($source['supported'] ? __('Verified adapter available.') : __('Import unavailable: source schema not verified.')) ?></p>
<?php endforeach; ?>
<?php if ($block->hasSupportedSource()): ?>
<form method="post" action="<?= $escaper->escapeUrl($block->getUrl('coresh_quoterequest/migration/run')) ?>" data-mage-init='{"Coresh_QuoteRequest/js/submit-once":{}}'>
    <?= $block->getBlockHtml('formkey') ?>
    <input type="hidden" name="mode" value="preview"/>
    <label><?= $escaper->escapeHtml(__('Original storefront store')) ?>
        <select name="store_id" required>
            <?php foreach ($block->getStoreOptions() as $option): ?>
                <option value="<?= (int) $option['value'] ?>" <?= (int) ($preview['store_id'] ?? 0) === $option['value'] ? 'selected' : '' ?>><?= $escaper->escapeHtml($option['label']) ?> (<?= (int) $option['value'] ?>)</option>
            <?php endforeach; ?>
        </select>
    </label>
    <button class="action-default" type="submit"><?= $escaper->escapeHtml(__('Preview migration')) ?></button>
</form>
<?php if (isset($preview['report']) && is_array($preview['report'])): ?>
<table class="data-grid"><tbody>
<?php foreach ($preview['report'] as $key => $value): ?>
    <tr><th><?= $escaper->escapeHtml((string) $key) ?></th><td><?= $escaper->escapeHtml((string) $value) ?></td></tr>
<?php endforeach; ?>
</tbody></table>
<?php endif; ?>
<?php if (isset($preview['token'])): ?>
<form method="post" action="<?= $escaper->escapeUrl($block->getUrl('coresh_quoterequest/migration/run')) ?>" data-mage-init='{"Coresh_QuoteRequest/js/submit-once":{}}'>
    <?= $block->getBlockHtml('formkey') ?>
    <input type="hidden" name="mode" value="execute"/>
    <input type="hidden" name="store_id" value="<?= (int) $preview['store_id'] ?>"/>
    <input type="hidden" name="preview_token" value="<?= $escaper->escapeHtmlAttr($preview['token']) ?>"/>
    <label><input type="checkbox" name="confirmed" value="1" required/> <?= $escaper->escapeHtml(__('The selected store is correct, a backup exists, and the old module is disabled. Import without deleting source data.')) ?></label>
    <button class="action-primary" type="submit"><?= $escaper->escapeHtml(__('Migrate Verified Legacy Data')) ?></button>
</form>
<?php endif; ?>
<?php endif; ?>
