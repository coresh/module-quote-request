<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="general">
        <field name="coresh_quote_request_enabled" sortOrder="85" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enable Quote Requests for Category</label>
                <notice translate="true">This category and its descendants may enable product requests within the current store root. Store configuration, customer group and date restrictions still apply.</notice>
                <dataScope>coresh_quote_request_enabled</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap><map name="false" xsi:type="number">0</map><map name="true" xsi:type="number">1</map></valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
