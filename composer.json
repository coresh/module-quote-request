{
    "name": "coresh/module-quote-request",
    "description": "Store-scoped product enquiries by email, configurable quote buttons and catalogue mode for Magento Open Source.",
    "type": "magento2-module",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-inventory": "^100.4",
        "magento/module-config": "^101.2",
        "magento/module-configurable-product": "^100.4",
        "magento/module-contact": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-eav": "^102.1",
        "magento/module-email": "^101.1",
        "magento/module-page-cache": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-checkout": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-ui": "^101.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "magento/magento-coding-standard": "^41.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Coresh\\QuoteRequest\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coresh\\QuoteRequest\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
