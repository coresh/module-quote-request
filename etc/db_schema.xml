<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="coresh_quote_request" resource="default" engine="innodb" comment="Coresh Product Quote Requests">
        <column xsi:type="int" name="request_id" unsigned="true" nullable="false" identity="true" comment="Request ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Original Store ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Historical Product ID"/>
        <column xsi:type="varchar" name="product_name" length="255" nullable="false" comment="Product Name Snapshot"/>
        <column xsi:type="varchar" name="product_sku" length="255" nullable="false" comment="Product SKU Snapshot"/>
        <column xsi:type="text" name="product_url" nullable="false" comment="Product URL Snapshot"/>
        <column xsi:type="varchar" name="product_type" length="32" nullable="false" default="simple" comment="Product Type"/>
        <column xsi:type="decimal" name="quantity" precision="12" scale="4" nullable="true" comment="Requested Unit Quantity"/>
        <column xsi:type="int" name="selected_product_id" unsigned="true" nullable="true" comment="Configurable Child ID"/>
        <column xsi:type="varchar" name="selected_product_sku" length="255" nullable="true" comment="Child SKU Snapshot"/>
        <column xsi:type="text" name="selected_options" nullable="true" comment="Validated Selection JSON"/>
        <column xsi:type="varchar" name="customer_name" length="128" nullable="false" comment="Enquirer Name"/>
        <column xsi:type="varchar" name="customer_email" length="254" nullable="false" comment="Enquirer Email"/>
        <column xsi:type="varchar" name="customer_telephone" length="64" nullable="true" comment="Enquirer Telephone"/>
        <column xsi:type="text" name="message" nullable="false" comment="Plain Text Enquiry"/>
        <column xsi:type="varchar" name="request_status" length="16" nullable="false" default="new" comment="Processing Status"/>
        <column xsi:type="varchar" name="email_status" length="16" nullable="false" default="pending" comment="Admin Email Transport Status"/>
        <column xsi:type="timestamp" name="email_lease_started_at" nullable="true" on_update="false" comment="Email Send Lease Acquired UTC"/>
        <column xsi:type="int" name="email_attempts" unsigned="true" nullable="false" default="0" comment="Transport Attempts"/>
        <column xsi:type="timestamp" name="last_email_sent_at" nullable="true" on_update="false" comment="Last Transport Acceptance UTC"/>
        <column xsi:type="varchar" name="last_error_code" length="64" nullable="true" comment="Safe Transport Error Code"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created UTC"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated UTC"/>
        <column xsi:type="varchar" name="idempotency_key" length="64" nullable="true" comment="Scoped Token Digest"/>
        <column xsi:type="varchar" name="payload_hash" length="64" nullable="true" comment="Validated Payload Digest"/>
        <column xsi:type="int" name="legacy_id" unsigned="true" nullable="true" comment="Original Legacy Request ID"/>
        <column xsi:type="varchar" name="quantity_origin" length="16" nullable="false" default="customer" comment="Quantity Provenance"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="request_id"/></constraint>
        <constraint xsi:type="unique" referenceId="CORESH_QR_TOKEN_UNIQUE"><column name="idempotency_key"/></constraint>
        <constraint xsi:type="unique" referenceId="CORESH_QR_LEGACY_UNIQUE"><column name="legacy_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="CORESH_QR_STORE_FK" table="coresh_quote_request" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="CORESH_QR_CUSTOMER_FK" table="coresh_quote_request" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="CORESH_QR_CREATED_IDX" indexType="btree"><column name="created_at"/></index>
        <index referenceId="CORESH_QR_STORE_IDX" indexType="btree"><column name="store_id"/></index>
        <index referenceId="CORESH_QR_EMAIL_IDX" indexType="btree"><column name="email_status"/></index>
    </table>
    <table name="coresh_quote_request_rate_limit" resource="default" engine="innodb" comment="Coresh Enquiry Rate Limit Buckets">
        <column xsi:type="varchar" name="bucket_key" length="64" nullable="false" comment="Hashed Client Bucket"/>
        <column xsi:type="int" name="hits" unsigned="true" nullable="false" default="0" comment="Attempts"/>
        <column xsi:type="bigint" name="expires_at" unsigned="true" nullable="false" comment="Expiry Unix Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="bucket_key"/></constraint>
        <index referenceId="CORESH_QR_RATE_EXPIRY_IDX" indexType="btree"><column name="expires_at"/></index>
    </table>
</schema>
