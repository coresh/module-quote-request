<?xml version='1.0' encoding='UTF-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default><coresh_quote_request>
        <general>
            <enabled>0</enabled><button_label>Contact Us for a Quote</button_label><scope>product</scope>
            <apply_to_all_products>0</apply_to_all_products><request_display>button</request_display>
            <show_inquiry_tab>0</show_inquiry_tab><restrict_customer_groups>0</restrict_customer_groups><customer_groups/><selected_categories/>
            <use_date_range>0</use_date_range><from_date/><to_date/>
        </general>
        <email>
            <enabled>1</enabled><recipient/><sender_identity>general</sender_identity>
            <admin_template>coresh_quote_request_email_admin_template</admin_template>
            <include_product_name>1</include_product_name><include_quantity>1</include_quantity><include_product_id>1</include_product_id>
            <customer_confirmation>0</customer_confirmation><customer_template>coresh_quote_request_email_customer_template</customer_template>
        </email>
        <catalog><hide_cart>0</hide_cart><disable_purchasing>0</disable_purchasing><hide_prices>0</hide_prices><allow_add_to_cart>1</allow_add_to_cart></catalog>
        <security><rate_limit_enabled>1</rate_limit_enabled><rate_limit_max>5</rate_limit_max><rate_limit_window>600</rate_limit_window><max_quantity>1000000</max_quantity><max_message_length>5000</max_message_length></security>
    </coresh_quote_request></default>
</config>
